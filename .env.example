# 复制成 .env 再填。.env 已在 .gitignore 里，凭证不会进 git。
#
# T0 的第一步（匿名 provision）不需要任何凭证：
#   make t0-probe
# 跑完会把 AGENT_WALLET_* 打印出来，填到这里即可继续后面的步骤。

# Cobo Agentic Wallet
# 注意：t0-probe 首次运行后会自动把真实值写回 .env 并复用，
# 这样钱包地址保持不变——用户去外部 faucet 领的币才不会变成孤儿。
AGENT_WALLET_API_URL=https://api.agenticwallet.cobo.com
AGENT_WALLET_API_KEY=
AGENT_WALLET_WALLET_ID=
AGENT_WALLET_ADDRESS=

# 探针 Pact 用（T0 会打印真实值）
PROBE_PACT_ID=

# 收款方 x402 服务
PAYEE_PORT=8001
PAY_TO_ADDRESS=

# Dashboard
DASHBOARD_PORT=8000
